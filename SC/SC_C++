#include <iostream>
#include <random>
#include <ctime>
#include <cmath>
#include <algorithm>

using namespace std;

int main() {
    int N;
    cout << "Enter the value of N: ";
    cin >> N;
    int nSop = 0;
    int nSon = 0;
    int error = 0;
    int correct = 0;
    int diff = 0;
    double avgError = 0;
    double totalscError = 0;
    double totalOurSchemeError = 0; // OUR Scheme error distance 누적 변수
    srand(time(NULL));

    for (int i = 0; i < N; i++) {
        string str1 = "";
        string str2 = "";
        string str3 = "";

        int countOnesPOS = 0; // 양수 그룹 내 1의 총 개수
        int countOnesNEG = 0; // 음수 그룹 내 1의 총 개수

        // 변수 초기화
        int p1[3][8] = { 0 }; // POS에서 각 자리의 1의 개수를 누적할 배열
        int n1[2][8] = { 0 }; // NEG에서 각 자리의 1의 개수를 누적할 배열
        int pr = 0; // 실제 곱셈에서 나온 양수들을 모두 더한 것 
        int nr = 0; // 실제 곱셈에서 나온 음수들을 모두 더한 것
        int sp[8] = { 0 }; // POS의 각 자리의 1의 개수 합을 저장할 배열
        int sn[8] = { 0 }; // NEG의 각 자리의 1의 개수 합을 저장할 배열
        int Ap[8] = { 0 }; // POS의 각 자리의 1의 개수 합을 저장할 배열
        int An[8] = { 0 }; // NEG의 각 자리의 1의 개수 합을 저장할 배열
        int Apn[8] = { 0 }; // POS의 각 자리의 1의 개수 합 - NEG의 각 자리의 1의 개수 합
        int Anp[8] = { 0 }; // NEG의 각 자리의 1의 개수 합 - POS의 각 자리의 1의 개수 합
        int Aop[9] = { 0 }; // POS와 NEG의 각 자리의 1의 개수의 차이를 누적한 배열
        int Aon[9] = { 0 }; // NEG와 POS의 각 자리의 1의 개수의 차이를 누적한 배열
        int Sop[8] = { 0 }; // POS와 NEG의 각 자리의 1의 개수의 차이에 따라 결정된 결과
        int Son[8] = { 0 }; // NEG와 POS의 각 자리의 1의 개수의 차이에 따라 결정된 결과

        // POS 그룹의 반복
        for (int p = 0; p < 3; p++) {
            for (int i = 0; i < 8; i++) {
                str1 += (rand() % 2) ? '1' : '0';
            }
            for (int i = 0; i < 8; i++) {
                str2 += (rand() % 2) ? '1' : '0';
            }

            for (int i = 0; i < 8; i++) {
                if (str1[i] == '1' && str2[i] == '1') {
                    str3 += '1';
                    p1[p][i]++; // 현재 자리에 1을 누적
                }
                else {
                    str3 += '0';
                }
            }

            // POS의 각 자리의 1의 개수 합을 계산하여 sp에 누적
            for (int i = 0; i < 8; i++) {
                sp[i] += p1[p][i];
            }
            int countOnes1 = count(str1.begin(), str1.end(), '1');
            int countOnes2 = count(str2.begin(), str2.end(), '1');
            int countOnes3 = count(str3.begin(), str3.end(), '1');
            pr += countOnes1 * countOnes2;
            cout << "POS" << p + 1 << " " << str1 << " (" << countOnes1 << "/8)" << " && " << str2 << " (" << countOnes2 << "/8) : " << str3 << " (" << countOnes3 << "/8)"
                << " Real Value: " << countOnes1 << "/8 * " << countOnes2 << "/8 = " << countOnes1 * countOnes2 << "/64" << "\n";
            str1 = "";
            str2 = "";
            str3 = "";
            countOnesPOS += countOnes3;
        }

        // NEG 그룹의 반복
        for (int n = 0; n < 2; n++) {
            for (int i = 0; i < 8; i++) {
                str1 += (rand() % 2) ? '1' : '0';
            }
            for (int i = 0; i < 8; i++) {
                str2 += (rand() % 2) ? '1' : '0';
            }

            for (int i = 0; i < 8; i++) {
                if (str1[i] == '1' && str2[i] == '1') {
                    str3 += '1';
                    n1[n][i]++; // 현재 자리에 1을 누적
                }
                else {
                    str3 += '0';
                }
            }

            // NEG의 각 자리의 1의 개수 합을 계산하여 sn에 누적
            for (int i = 0; i < 8; i++) {
                sn[i] += n1[n][i];
            }
            int countOnes1 = count(str1.begin(), str1.end(), '1');
            int countOnes2 = count(str2.begin(), str2.end(), '1');
            int countOnes3 = count(str3.begin(), str3.end(), '1');
            nr += countOnes1 * countOnes2;
            cout << "NEG" << n + 1 << " " << str1 << " (" << countOnes1 << "/8)" << " && " << str2 << " (" << countOnes2 << "/8) : " << str3 << " (-" << countOnes3 << "/8)"
                << " Real Value: " << countOnes1 << "/8 * " << countOnes2 << "/8 = -" << countOnes1 * countOnes2 << "/64" << "\n";
            str1 = "";
            str2 = "";
            str3 = "";
            countOnesNEG += countOnes3;
        }

        // Ap 출력
        cout << "Ap     : ";
        for (int i = 0; i < 8; i++) {
            Ap[i] = sp[i] + (i > 0 ? Ap[i - 1] : 0);
            cout << Ap[i] << " ";
        }
        cout << endl;

        // An 출력
        cout << "An     : ";
        for (int i = 0; i < 8; i++) {
            An[i] = sn[i] + (i > 0 ? An[i - 1] : 0);
            cout << An[i] << " ";
        }
        cout << endl << endl;

        // Ap - An 출력
        cout << "Ap - An: ";
        for (int i = 0; i < 8; i++) {
            Apn[i] = Ap[i] - An[i];
            cout << Apn[i] << " ";
        }
        cout << endl;
        cout << endl;

        // Aop 출력
        cout << "Aop    : ";
        for (int i = 0; i < 8; i++) {
            if (Apn[i] > Aop[i]) {
                Sop[i] = 1;
            }
            else {
                Sop[i] = 0;
            }
            Aop[i + 1] = Aop[i] + Sop[i];
            cout << Aop[i] << " ";
        }

        cout << endl;

        // Sop 출력
        cout << "Sop    : ";
        for (int i = 0; i < 8; i++) {
            cout << Sop[i] << " ";
        }
        cout << endl;
        cout << endl;

        // An - Ap 출력
        cout << "An - Ap: ";
        for (int i = 0; i < 8; i++) {
            Anp[i] = An[i] - Ap[i];
            cout << Anp[i] << " ";
        }
        cout << endl << endl;

        // Aon 출력
        cout << "Aon    : ";
        for (int i = 0; i < 8; i++) {
            if (Anp[i] > Aon[i]) {
                Son[i] = 1;
            }
            else {
                Son[i] = 0;
            }
            Aon[i + 1] = Aon[i] + Son[i];
            cout << Aon[i] << " ";
        }

        cout << endl;

        // Son 출력
        cout << "Son    : ";
        for (int i = 0; i < 8; i++) {
            cout << Son[i] << " ";
        }
        cout << endl;
        cout << endl;

        // 결과 출력
        int countOnesResult = 0;
        cout << "SC Result: ";
        if (Ap[7] > An[7]) {
            for (int i = 0; i < 8; i++) {
                cout << Sop[i];
                countOnesResult += Sop[i];
                nSop++;
            }
        }
        else {
            for (int i = 0; i < 8; i++) {
                cout << Son[i];
                countOnesResult += Son[i];
                nSon++;
            }
        }
        cout << " (" << countOnesResult << "/8)";

        // BSC Result의 error distance 계산 및 출력
        double scError = 0;
        if (pr - nr > 0)
            scError = abs(pr - nr - (8 * countOnesResult));
        else
            scError = abs(pr - nr + (8 * countOnesResult));
        avgError += scError;
        totalscError += scError; // SC error distance 누적

        if (countOnesPOS > countOnesNEG) {
            if (countOnesResult == countOnesPOS - countOnesNEG) {
                cout << " (O)" << endl;
                correct++;
            }
            else {
                cout << " (X)" << endl;
                error++;
            }
        }
        else if (countOnesPOS < countOnesNEG) {
            if (countOnesResult == countOnesNEG - countOnesPOS) {
                cout << " (O)" << endl;
                correct++;
            }
            else {
                cout << " (X)" << endl;
                error++;
            }
        }
        else {
            if (countOnesResult == 0) {
                cout << " (O)" << endl;
                correct++;
            }
            else {
                cout << " (X)" << endl;
                error++;
            }
        }

        // 실제 결과 출력
        cout << "Real Result: " << pr - nr << "/64" << endl;
        cout << "SC Error Distance: " << scError << "/64" << endl << endl;
    }

    // BSC Result의 평균 error distance 출력
    cout << "Average SC Result Error Distance: " << totalscError / N << "/64" << endl;

    return 0;
}
